# Personal working notes (per-user CLAUDE context, individual TODOs).
# Shared project rules and onboarding live in docs/PARTNER_ONBOARDING.md.
CLAUDE.md
TODO.md

# Build output
build/

# Runtime logs (decision logs + stderr from local 3-replica test scripts)
logs/

# Runtime state generated by `make demo-deploy` (bare repo + agent dirs).
demo/work/

# Local docker-compose env (machine-specific UID/GID). Commit
# `.env.example` as a template; each contributor copies it to `.env`.
.env

# Stray log files at root (older script versions wrote here; tolerated).
# Root-anchored (leading slash) so captured run logs under demo/runs/
# don't get silently ignored too.
/tm-server.log
/tm-*.log
/tm-*.stderr

# Local snapshot artifacts produced by tm-replay (regenerated by
# `make -C demo demo-replay-verify`). The committed copies live inside
# demo/runs/<scenario>/ alongside the logs they replay from.
/snapshots.json
/snapshots-*.json
