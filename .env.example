# docker-compose project + UID mapping for the pset4 demo.
# Copy to `.env` (which is gitignored) and edit UID/GID to match your
# host user so bind-mounted log files end up host-owned. Find your UID
# with `id -u` and GID with `id -g`.
#
# COMPOSE_PROJECT_NAME drives the docker network name
# (`<name>_default`), referenced by demo-partition-N / demo-reconnect-N.

COMPOSE_PROJECT_NAME=pset4demo
UID=1000
GID=1000
