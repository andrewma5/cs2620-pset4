    PY="py -3"
elif command -v python3 >/dev/null 2>&1 && python3 --version >/dev/null 2>&1; then
    PY="python3"
else
    echo "tm.env: no python launcher (tried 'py -3' and 'python3')" >&2
fi

tm() { $PY "$SKILL_DIR/tm" "$@"; }
